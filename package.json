{
  "name": "futurecontext-edge-extension",
  "private": true,
  "type": "module",
  "version": "0.4.0",
  "description": "Local-first AI asset library for Edge and Chrome",
  "scripts": {
    "test:github-live": "node scripts/github-live.mjs",
    "test": "node --experimental-vm-modules --test test/*.test.mjs",
    "coverage": "node --experimental-vm-modules --test --experimental-test-coverage --test-coverage-lines=92 --test-coverage-include=src/**/*.js --test-coverage-exclude=test/** --test-coverage-exclude=node_modules/** test/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "marked": "18.0.13"
  }
}
