{
  "name": "futurecontext-edge-extension",
  "private": true,
  "type": "module",
  "version": "0.4.0",
  "description": "Local-first AI asset library for Edge and Chrome",
  "scripts": {
    "test:github-live": "node scripts/github-live.mjs",
    "test": "node --experimental-vm-modules --test test/*.test.mjs",
    "coverage": "node --experimental-vm-modules --test --experimental-test-coverage --test-coverage-lines=92 --test-coverage-include=dist/**/*.js --test-coverage-exclude=test/** --test-coverage-exclude=node_modules/** test/*.test.mjs",
    "check": "npm run build && node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "precoverage": "npm run build",
    "pretest:github-live": "npm run build",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/wicg-file-system-access": "^2023.10.7",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "marked": "18.0.13"
  }
}
